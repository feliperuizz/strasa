APP_NAME="STRASA Conteúdo"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.suaagencia.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Banco MySQL/MariaDB do cPanel (geralmente com prefixo do usuário)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpuser_strasa
DB_USERNAME=cpuser_strasa
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
ATTACHMENTS_DISK=s3

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.suaagencia.com.br
MAIL_PORT=465
MAIL_USERNAME=no-reply@suaagencia.com.br
MAIL_PASSWORD=
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS="no-reply@suaagencia.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Storage S3-compatible (Cloudflare R2 / Backblaze B2 / AWS S3) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
